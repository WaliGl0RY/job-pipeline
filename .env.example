# Environment variables read by the Python scripts in core/.
# Python does not load this file on its own: export the values in your shell
# (or let your editor/terminal load .env) before running the scripts.

# Where the data layer lives (jobs.db, descriptions.json, packages/, ...).
# Absolute, or relative to the repository root. Default: data
JOB_PIPELINE_DATA_DIR=data

# The embedded data contains non-ASCII text; this keeps console output
# readable on Windows.
PYTHONIOENCODING=utf-8

# There are NO API keys here on purpose:
# - no ANTHROPIC_API_KEY: all reasoning runs inside Claude (subscription), no script calls a model
# - the Apify token, Indeed and Gmail logins live in Claude's connector settings, not in this repo
